{"standard_id":"DEGREE-FORMAT-EXPR-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"表达规范","title":"避免口语化和网络化表达","rule_text":"论文写作应采用正式、清晰的书面表达，避免口语化、网络化以及频繁使用逗号造成的碎片化断句。","common_defects":["口语化表达","句子被逗号过度切碎","社交媒体式表达"],"severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于表达，第1项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-EXPR-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"表达规范","title":"控制句子长度","rule_text":"应避免单句过长导致逻辑关系不清；复杂内容应按照语义关系合理拆分。","common_defects":["一句话跨越多行且层次不清","多个非并列动作挤在同一句中"],"severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于表达，第2至5项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-EXPR-003","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"表达规范","title":"检查主谓和动宾搭配","rule_text":"长句应检查主语与谓语、谓语与宾语之间的搭配是否恰当，句子核心成分应完整。","common_defects":["缺少谓语","主谓搭配不当","动宾搭配不当"],"severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于表达，第3至6项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FIGURE-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"图表字号要求","rule_text":"原则上，图和表中的字号应比正文字号小一号。","severity":"low","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第1项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FIGURE-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"图标题位置","rule_text":"图标题应位于图的底部并居中对齐。","common_defects":["图标题位于图上方","标题未居中"],"severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第2项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-TABLE-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"表标题位置","rule_text":"表格标题应位于表格顶部并居中对齐。","common_defects":["表标题位于表下方","标题未居中"],"severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第3项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FIGURE-003","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"图不应跨页","rule_text":"图原则上不应跨页；图过大时应缩小到一页范围内，或拆分为整体图和细节图。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第4项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-TABLE-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"跨页表格续表要求","rule_text":"表格应尽量避免跨页；确需分页时，后续页顶部应重复表标题并标示为继续。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第5项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FIGURE-004","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"图必须配有正文说明","rule_text":"论文中的图应配以适当的文字说明，引导读者理解图的内容及其与正文论点的关系。","common_defects":["正文未引用图","只出现图而没有解释","未说明图支持的结论"],"severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第6项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FIGURE-005","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"图表规范","title":"图的位置与阅读布局","rule_text":"图应避免出现在页底部；流程图和结构图的整体布局应符合从上到下、从左到右的通常阅读顺序。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第7至8项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FLOW-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"流程图规范","title":"流程图连线与判断框","rule_text":"流程图应尽量避免折线；判断框原则上是一进双出，如果存在多种判断结果，应拆分为多个判断框。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第9至10项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FLOW-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"流程图规范","title":"正确区分处理与数据","rule_text":"流程图中处理操作应使用矩形表示，流动的数据应标注在箭头线上，不应混淆处理和数据。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第11项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FLOW-003","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"流程图规范","title":"标明开始结束和输出类型","rule_text":"流程图应明确标识开始和结束；输出到数据库与输出到文件应使用对应的不同图例，不应统一使用处理矩形。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第12至13项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-CHART-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"统计图规范","title":"坐标轴含义与单位","rule_text":"变化曲线、折线图和柱状图等应明确标识横轴、纵轴的含义和单位。","severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第14项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-CHART-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"统计图规范","title":"合理设置纵轴范围","rule_text":"纵轴的最小值和最大值应合理设置，避免因范围过窄而夸大数据差异、误导读者。","severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第1页，关于图和表，第15项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FORMULA-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"公式规范","title":"公式对齐和编号","rule_text":"公式应居中对齐，并按照其在每章中的出现顺序编号，例如公式（3-2）表示第3章第2条公式。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于公式，第1至2项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FORMULA-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"公式规范","title":"解释公式变量和常量","rule_text":"公式之后应另起一行说明公式中使用的变量或常量，说明文字无需缩进。","common_defects":["变量未定义","定义与公式距离过远","使用符号但未说明含义"],"severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于公式，第3项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-FORMULA-003","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"公式规范","title":"公式符号全文统一","rule_text":"公式中的变量名称、符号和字体样式应全文统一，并符合相应专业的符号规范与使用习惯。","severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于公式，第4至5项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-PUNCT-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"标点与术语","title":"中英文标点与语言一致","rule_text":"中文论文应使用中文标点，英文论文应使用英文标点，特别应检查英文变量附近因输入法切换产生的错误标点。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于标点符号，第8至9项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-PUNCT-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"标点与术语","title":"成对符号和全角半角统一","rule_text":"括号、引号等成对符号应完整出现并保持前后统一；中文论文统一使用中文全角符号，英文论文统一使用英文符号。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于标点符号，第10项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-TERM-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"标点与术语","title":"名称和大小写全文统一","rule_text":"论文中出现的算法名、模型名和其他名称应遵循原名称并保持全文统一，避免出现多种大小写或拼写形式。","severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于标点符号，第11项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-TERM-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"标点与术语","title":"缩写首次出现时定义","rule_text":"算法或专业名称可以使用常见英文缩写，但首次出现时应给出中英文全称和缩写。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于标点符号，第12项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-LAYOUT-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"页面布局","title":"避免非章末页底留白","rule_text":"除每章结束位置外，页面底部不应出现明显留白；可通过调整图表位置或文字顺序改善布局。","severity":"low","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于论文格式和布局，第1项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-LAYOUT-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"页面布局","title":"中文段落缩进两个汉字","rule_text":"中文论文每个正文段落开头应统一缩进两个汉字。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于论文格式和布局，第2项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-LAYOUT-003","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"页面布局","title":"标题不应孤立在页底","rule_text":"各级标题不应单独出现在页面底部而正文从下一页开始，应调整前文图文布局使标题与后续正文保持合理位置。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第2页，关于论文格式和布局，第3项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-REF-001","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"参考文献","title":"参考文献排列规则一致","rule_text":"中文论文的参考文献可以按照正文中的首次出现顺序排列，所采用的排序规则应保持一致。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第3页，关于参考文献，第1项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-REF-002","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"参考文献","title":"英文作者姓名和出版信息完整","rule_text":"英文参考文献的作者姓名顺序和大小写应统一，并应检查期刊名称、卷、期、页码等出版信息。","severity":"high","source_name":"学位论文的格式检查（2026）","source_locator":"第3页，关于参考文献，第2项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-REF-003","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"参考文献","title":"控制网址和低相关性文献","rule_text":"参考文献可以包含网址，但应尽量减少；与论文核心内容关系不大的参考文献也应减少。","severity":"low","source_name":"学位论文的格式检查（2026）","source_locator":"第3页，关于参考文献，第3至4项","standard_version":"degree_format_2026.1","status":"active"}
{"standard_id":"DEGREE-FORMAT-REF-004","paper_type":"degree","rule_scope":"format_degree","category":"writing_standard","dimension":"参考文献","title":"检查预印本正式发表状态","rule_text":"引用预印本前应检查其是否已经正式发表；一般情况下应减少仅引用预印本版本。","severity":"medium","source_name":"学位论文的格式检查（2026）","source_locator":"第3页，关于参考文献，第5项","standard_version":"degree_format_2026.1","status":"active"}
