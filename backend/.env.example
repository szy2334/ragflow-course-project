# Runtime mode and persistent dependencies. Production requires PostgreSQL and Redis.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://paper_review:change-me@localhost:5432/paper_review
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_SECRET=replace-with-a-random-32-byte-or-longer-secret

# API and local file storage
CORS_ORIGINS=http://localhost:5173
OBJECT_STORAGE_PATH=./var/uploads
# Absolute path to the copied reference-paper artifacts. Only its runs/ subtree is served.
USER_PAPER_ROOT=../user_paper
MAX_UPLOAD_MB=50

# OpenAI-compatible structured model. Do not commit actual credentials.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=120
LLM_STRUCTURED_MODE=json_schema
# SiliconFlow Qwen thinking-capable models need this disabled for strict JSON output.
# LLM_ENABLE_THINKING=false
QA_ARCHITECTURE_V3_ENABLED=true
PAPER_SUMMARY_ENABLED=true
MODEL_CONFIG_VERSION=env-v1
GRAPH_VERSION=1.0
PROMPT_VERSION=v1
SCHEMA_VERSION=v1

# Parser, specialized OCR, and the RAGFlow service used by format profiles.
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_TOKEN=replace-me
BAIDU_OCR_API_KEY=replace-me
BAIDU_OCR_SECRET_KEY=replace-me
BAIDU_OCR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_OCR_ACCURATE_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic
BAIDU_OCR_TABLE_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/table
BAIDU_OCR_PADDLE_TASK_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task
BAIDU_OCR_PADDLE_QUERY_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task/query
RAGFLOW_BASE_URL=http://ragflow:9380
RAGFLOW_API_KEY=replace-me
# Each format profile stores its own server-side RAGFlow dataset mapping via
# POST /api/v1/admin/format-profiles. Do not configure user PDFs as a dataset.
