# Runtime mode and persistent dependencies. Production requires PostgreSQL and Redis.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://paper_review:change-me@localhost:5432/paper_review
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_SECRET=replace-with-a-random-32-byte-or-longer-secret

# API and local file storage
CORS_ORIGINS=http://localhost:5173
OBJECT_STORAGE_PATH=./var/uploads
MAX_UPLOAD_MB=50

# OpenAI-compatible structured model. Do not commit actual credentials.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
MODEL_CONFIG_VERSION=env-v1
GRAPH_VERSION=1.0
PROMPT_VERSION=v1
SCHEMA_VERSION=v1
STANDARD_VERSION=standards-v1

# Parser, specialized OCR, and the two RAGFlow knowledge bases.
MINERU_BASE_URL=http://mineru:8000
MINERU_API_KEY=replace-me
BAIDU_OCR_BASE_URL=https://ocr.example.com
BAIDU_OCR_API_KEY=replace-me
RAGFLOW_BASE_URL=http://ragflow:9380
RAGFLOW_API_KEY=replace-me
RAGFLOW_REFERENCE_DATASET_ID=user_paper
# Deprecated compatibility fallback. Do not point uploaded PDFs at a RAGFlow dataset.
RAGFLOW_USER_DATASET_ID=
RAGFLOW_PUBLIC_DATASET_ID=public-review-standards
