# Copy this file to .env and fill the blank credential values locally.
# .env is ignored by Git. Never commit real keys or tokens.

# Required credentials
MINERU_TOKEN=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
RAGFLOW_API_KEY=

# Service endpoints
MINERU_BASE_URL=https://mineru.net/api/v4
RAGFLOW_BASE_URL=http://localhost:9380/api/v1
BAIDU_OCR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_OCR_ACCURATE_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic
BAIDU_OCR_TABLE_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/table
BAIDU_OCR_PADDLE_TASK_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task
BAIDU_OCR_PADDLE_QUERY_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task/query

# Pipeline defaults. Change these paths for another PDF.
USER_PAPER_PDF=D:\JIXUN\UMAP.pdf
USER_PAPER_OUTPUT_ROOT=D:\JIXUN\data\user_paper_runs
USER_PAPER_RUN_NAME=umap_e2e_rerun
USER_PAPER_FALLBACK_MINERU_DIR=D:\JIXUN\MinerU_data\UMAP.pdf-dac2a9bc-648b-4f1f-b943-012970808954
USER_PAPER_DATASET_ID=
USER_PAPER_DATASET_NAME=user_papers_private_rerun
USER_PAPER_USER_ID=local-user

# Keep the specialised Baidu OCR route mandatory; no silent degradation.
USER_PAPER_STRICT_SPECIALIZED=true
USER_PAPER_FORCE_OCR=true

# QA baseline defaults. Command-line flags override these values.
USER_PAPER_QA_GOLDEN=D:\JIXUN\data\user_paper_runs\umap_e2e_rerun\05_qa_baseline\golden.json
USER_PAPER_QA_RESULTS=D:\JIXUN\data\user_paper_runs\umap_e2e_rerun\05_qa_baseline\results.json
USER_PAPER_QA_CHUNK_MAPPING=D:\JIXUN\data\user_paper_runs\umap_e2e_rerun\04_ragflow\chunk_mapping.jsonl
USER_PAPER_QA_OUTPUT_JSON=D:\JIXUN\data\user_paper_runs\umap_e2e_rerun\05_qa_baseline\baseline_report.json
USER_PAPER_QA_OUTPUT_MD=D:\JIXUN\data\user_paper_runs\umap_e2e_rerun\05_qa_baseline\baseline_report.md
USER_PAPER_QA_STRICT=false
USER_PAPER_QA_TIMEOUT=300
USER_PAPER_QA_RETRIES=2
USER_PAPER_QA_QUOTE=true
USER_PAPER_QA_RESUME=true
USER_PAPER_QA_DATASET_ID=
USER_PAPER_QA_DOCUMENT_ID=
USER_PAPER_QA_PAGE_SIZE=8
USER_PAPER_QA_SIMILARITY_THRESHOLD=0
USER_PAPER_QA_VECTOR_SIMILARITY_WEIGHT=0.3
# Comma-separated target languages. Use English for Chinese queries against English papers.
USER_PAPER_QA_CROSS_LANGUAGES=

# Query-time adapter defaults.  These are read by ai_retrieval_adapter.py,
# which is injected as app.ai's RetrievalPort by the API/task layer.
USER_PAPER_AI_TIMEOUT=20
USER_PAPER_AI_RETRIES=1
USER_PAPER_AI_PAGE_SIZE=8
USER_PAPER_AI_RELAXED_PAGE_SIZE=12
USER_PAPER_AI_SIMILARITY_THRESHOLD=0.2
USER_PAPER_AI_RELAXED_SIMILARITY_THRESHOLD=0
USER_PAPER_AI_VECTOR_SIMILARITY_WEIGHT=0.3
USER_PAPER_AI_CROSS_LANGUAGES=
